# REACT_APP_NODE_ENV=development is set when `npm start` is run
REACT_APP_NODE_ENV=development
REACT_APP_BFF_HOST=https://bff.dev.example.org

# webpack host (not socket)
HOST='0.0.0.0'

# webpack server socket: https://webpack.js.org/configuration/dev-server/#websocketurl
# https://create-react-app.dev/docs/advanced-configuration/
# WDS_SOCKET_PORT=0 will use the current window.location's port
# 0.0.0.0 for all inbound, not just a binding to localhost in the container
WDS_SOCKET_HOST='0.0.0.0'
# default is auto, force secure
WDS_SOCKET_PROTO=wss

# TLS
# our entire stack runs TLS for interservice communication
# without tls, interacting with cookies as BFF serves our application over TLS
# these environmental variables interact with webpack config and getHttpsConfig.js

# HTTPS must be exactly 'true'
HTTPS=true
# cert and key must correspond with locations on disk, in this case, provided by our Dockerfile
TLS_CRT_FILE='/opt/project/deps_workstation/tls/server.crt'
TLS_KEY_FILE='/opt/project/deps_workstation/tls/server.key'

# envvar feature flags
